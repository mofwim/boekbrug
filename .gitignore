/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# [GOCARDLESS/PSD2] Private keys and certificates for a bank-data provider.
#
# *.pem above only catches one of the names these are generated under. Enable Banking's own
# instructions produce `private.key` and `public.crt` — neither matched, so following those
# instructions inside the repo put an RSA key that unlocks users' BANK ACCOUNTS one `git add -A`
# away from a public remote. A leaked private key here is not a password anyone can rotate
# quietly: it signs the tokens that read someone's bank.
#
# Deliberately broad. A build never needs a private key, so a false positive costs nothing and
# the alternative costs everything.
*.key
*.crt
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
